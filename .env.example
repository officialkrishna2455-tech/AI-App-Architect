# ══════════════════════════════════════════════════════════════
# Requirement Compiler — Environment Configuration
# ══════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────
APP_NAME=Requirement Compiler
DEBUG=false

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./requirement_compiler.db

# ── Authentication ───────────────────────────────────────────
SECRET_KEY=your-secret-key-change-this-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=compiler2024

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Compiler Settings ────────────────────────────────────────
MAX_PARALLEL_RUNS=4
COMPILATION_TIMEOUT_SECONDS=120
SPACY_MODEL=en_core_web_sm

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
